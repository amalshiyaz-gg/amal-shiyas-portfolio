    replacement_chunks {
      replacement_content: "import { FileDown, Calendar, GraduationCap, Award, FileText } from \"lucide-react\";\n\ninterface ResumeProps {\n  onDownloadResume: () => void;\n}\n\nexport default function Resume({ onDownloadResume }: ResumeProps) {\n  return (\n    <section id=\"resume\" className=\"py-24 bg-[#181818] border-b border-white/[0.03]\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        \n        {/* Section Header */}\n        <div className=\"flex items-center gap-4 mb-12\">\n          <div className=\"h-[1px] w-12 bg-[#D32F2F]\" />\n          <h2 className=\"text-xs font-mono uppercase tracking-widest text-[#D32F2F]\">\n            05 / Academic & Credentials\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          {/* LEFT COLUMN: Resume Technical Overview Card */}\n          <div className=\"lg:col-span-8 space-y-6\">\n            <div className=\"p-6 md:p-8 rounded-lg bg-[#202020] border border-white/[0.03] space-y-6\">\n              \n              <div className=\"flex items-center gap-2 pb-4 border-b border-white/[0.05]\">\n                <GraduationCap className=\"text-[#D32F2F]\" size={20} />\n                <h3 className=\"font-sans font-bold text-lg text-white\">Education & Foundations</h3>\n              </div>\n\n              <div className=\"relative border-l border-white/[0.05] pl-6 ml-3 space-y-8\">\n                \n                {/* Timeline node 1 */}\n                <div className=\"relative\">\n                  <span className=\"absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-black border border-[#D32F2F] flex items-center justify-center\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-[#D32F2F]\" />\n                  </span>\n                  \n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-1\">\n                    <h4 className=\"font-sans font-bold text-sm text-white\">\n                      Bachelor of Technology in Mechanical Engineering\n                    </h4>\n                    <span className=\"font-mono text-[10px] text-[#EF5350] bg-white/[0.02] border border-white/[0.05] px-2 py-0.5 rounded flex items-center gap-1 w-max\">\n                      <Calendar size={10} /> Passed Out Graduate\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-[#B0B0B0] mt-1\">\n                    Specialized coursework in Automotive Engineering, Fluid Power Systems, Machine Design, CAD Drafting, and Manufacturing Technologies.\n                  </p>\n                </div>\n\n                {/* Timeline node 2 */}\n                <div className=\"relative\">\n                  <span className=\"absolute -left-[31px] top-1.5 w-4 h-4 rounded-full bg-black border border-[#D32F2F] flex items-center justify-center\">\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-[#D32F2F]\" />\n                  </span>\n\n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-1\">\n                    <h4 className=\"font-sans font-bold text-sm text-white\">\n                      Professional CAD Specialization (Fusion 360 & Assemblies)\n                    </h4>\n                    <span className=\"font-mono text-[10px] text-gray-500 flex items-center gap-1 w-max\">\n                      Interactive Training\n                    </span>\n                  </div>\n                  <p className=\"text-xs text-[#B0B0B0] mt-1\">\n                    Acquired direct training in generative design parameters, sheet metal rules, physical joint tolerances, exploded views, and rendering workflows.\n                  </p>\n                </div>\n\n              </div>\n\n              {/* Research/Academic Project Spotlight */}\n              <div className=\"p-4 rounded bg-[#181818] border border-white/[0.03] space-y-2\">\n                <div className=\"flex items-center gap-2 text-[#EF5350]\">\n                  <Award size={14} />\n                  <span className=\"font-mono text-[10px] uppercase tracking-wider font-semibold\">\n                    Core Engineering Academic Focus\n                  </span>\n                </div>\n                <p className=\"text-xs text-gray-400 leading-relaxed\">\n                  Participated directly in multiple mechatronic sensor integration and physical mechanical research projects, focusing heavily on pressure-deflection tracking in compliance systems and active safety controllers.\n                </p>\n              </div>\n\n            </div>\n          </div>\n\n          {/* RIGHT COLUMN: Print/Download Trigger Card */}\n          <div className=\"lg:col-span-4\">\n            <div className=\"h-full p-6 md:p-8 rounded-lg bg-[#202020] border border-[#D32F2F]/20 hover:border-[#D32F2F] transition-all duration-300 flex flex-col justify-between text-center relative overflow-hidden group\">\n              \n              {/* Geometric Grid Accent */}\n              <div className=\"absolute inset-0 bg-gradient-to-b from-[#D32F2F]/5 via-transparent to-transparent opacity-30 pointer-events-none\" />\n              <div className=\"absolute top-2 left-2 text-[9px] font-mono text-gray-500\">\n                PORT_DOCS\n              </div>\n\n              <div className=\"space-y-6 pt-6\">\n                <div className=\"mx-auto w-16 h-16 rounded-full bg-[#181818] border border-white/[0.05] group-hover:border-[#D32F2F]/30 flex items-center justify-center text-[#D32F2F] transition-all duration-300\">\n                  <FileText size={28} />\n                </div>\n\n                <div className=\"space-y-2\">\n                  <h3 className=\"font-sans font-bold text-lg text-white\">\n                    Need the Offline File?\n                  </h3>\n                  <p className=\"text-xs text-gray-400 max-w-xs mx-auto leading-relaxed\">\n                    Download the complete, pre-vetted Mechanical Engineer resume, including full contact information, professional experience logs, and educational score archives.\n                  </p>\n                </div>\n              </div>\n\n              <button\n                onClick={onDownloadResume}\n                className=\"w-full mt-8 py-3 bg-[#D32F2F] hover:bg-[#EF5350] text-white font-mono text-xs uppercase tracking-wider font-bold rounded-sm transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-[#D32F2F]/10 cursor-pointer\"\n              >\n                <FileDown size={14} />\n                Download PDF Resume\n              </button>\n\n            </div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
