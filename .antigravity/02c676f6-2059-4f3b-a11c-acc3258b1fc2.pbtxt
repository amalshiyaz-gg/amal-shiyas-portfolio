    replacement_chunks {
      replacement_content: "import { Linkedin, Github, FileText, ArrowRight } from \"lucide-react\";\nimport CADCanvas from \"./CADCanvas\";\nimport profileImg from \"../assets/images/profile_1781816280057.jpg\";\n\ninterface HeroProps {\n  onViewProjects: () => void;\n  onDownloadResume: () => void;\n}\n\nexport default function Hero({ onViewProjects, onDownloadResume }: HeroProps) {\n  return (\n    <section id=\"home\" className=\"relative min-h-screen flex items-center bg-[#0F0F0F] pt-16 overflow-hidden\">\n      {/* Interactive CAD background mesh */}\n      <CADCanvas />\n\n      {/* Foreground Container */}\n      <div className=\"relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-24 z-10 w-full\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n          \n          {/* LEFT SIDE: Professional Profile Photo */}\n          <div className=\"lg:col-span-4 flex justify-center order-1 lg:order-1\">\n            <div className=\"relative group\">\n              {/* Spinning technical coordinate grid around image */}\n              <div className=\"absolute -inset-4 rounded-2xl border border-dashed border-[#D32F2F]/30 animate-[spin_50s_linear_infinite]\" />\n              <div className=\"absolute -inset-1 rounded-2xl bg-gradient-to-r from-[#D32F2F] to-[#EF5350] opacity-30 blur-sm group-hover:opacity-60 transition duration-300\" />\n              \n              <div className=\"relative w-64 h-64 sm:w-80 sm:h-80 rounded-2xl overflow-hidden border-2 border-[#D32F2F] shadow-2xl bg-[#181818] flex items-center justify-center\">\n                <img\n                  src={profileImg}\n                  alt=\"Amal Shiyas\"\n                  referrerPolicy=\"no-referrer\"\n                  className=\"w-full h-full object-cover grayscale brightness-90 hover:grayscale-0 transition-all duration-500 scale-102 hover:scale-105\"\n                />\n                \n                {/* CAD crosshairs overlay decorative */}\n                <span className=\"absolute top-2 left-2 text-[8px] font-mono text-[#D32F2F]/60\">ISO PROJ v1.0</span>\n                <span className=\"absolute bottom-2 right-2 text-[8px] font-mono text-[#D32F2F]/60\">AMAL_SHIYAS.IGS</span>\n              </div>\n            </div>\n          </div>\n\n          {/* RIGHT SIDE: Information */}\n          <div className=\"lg:col-span-8 space-y-6 order-2 lg:order-2 text-center lg:text-left\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded bg-white/[0.02] border border-white/[0.05]\">\n              <span className=\"w-2 h-2 rounded-full bg-[#D32F2F] animate-pulse\" />\n              <span className=\"font-mono text-[10px] uppercase tracking-widest text-[#B0B0B0]\">\n                Now Active at Wipro Infrastructure Engineering\n              </span>\n            </div>\n\n            <div className=\"space-y-2\">\n              <h1 className=\"text-4xl sm:text-6xl font-sans font-bold tracking-tight text-white leading-none\">\n                Amal Shiyas\n              </h1>\n              <p className=\"text-lg sm:text-2xl font-mono text-[#D32F2F] font-semibold tracking-wide\">\n                Mechanical Engineer | CAD Designer\n              </p>\n            </div>\n\n            <p className=\"max-w-xl text-[#B0B0B0] text-sm sm:text-base leading-relaxed\">\n              Mechanical Engineering graduate currently working as an Apprentice Engineer at Wipro Infrastructure Engineering, Chennai. Passionate about automotive design, mechanical integration, high-density physical packaging, product development, and engineering leadership.\n            </p>\n\n            {/* Technical Parameters Display */}\n            <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-4 py-4 border-t border-b border-white/[0.05] max-w-xl font-mono\">\n              <div>\n                <span className=\"block text-[10px] text-[#B0B0B0] uppercase\">CAD Platform</span>\n                <span className=\"text-white text-xs font-semibold\">Fusion 360 Expert</span>\n              </div>\n              <div>\n                <span className=\"block text-[10px] text-[#B0B0B0] uppercase\">Focus Fields</span>\n                <span className=\"text-white text-xs font-semibold\">Automotive & Precision</span>\n              </div>\n              <div className=\"col-span-2 sm:col-span-1\">\n                <span className=\"block text-[10px] text-[#B0B0B0] uppercase\">Apprenticeship</span>\n                <span className=\"text-[#EF5350] text-xs font-semibold\">Assembly Ops</span>\n              </div>\n            </div>\n\n            {/* Action Buttons */}\n            <div className=\"flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4\">\n              <button\n                onClick={onViewProjects}\n                className=\"w-full sm:w-auto px-6 py-3 bg-[#D32F2F] hover:bg-[#EF5350] text-white font-mono text-xs uppercase tracking-wider font-semibold rounded-sm transition-all duration-200 flex items-center justify-center gap-2 group cursor-pointer shadow-lg shadow-[#D32F2F]/20\"\n              >\n                View Projects\n                <ArrowRight size={14} className=\"group-hover:translate-x-1 transition-transform\" />\n              </button>\n\n              <button\n                onClick={onDownloadResume}\n                className=\"w-full sm:w-auto px-6 py-3 bg-[#181818] hover:bg-[#202020] text-white border border-white/[0.1] hover:border-[#D32F2F] font-mono text-xs uppercase tracking-wider font-semibold rounded-sm transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer\"\n              >\n                <FileText size={14} />\n                Download Resume\n              </button>\n            </div>\n\n            {/* Social Channels */}\n            <div className=\"flex items-center justify-center lg:justify-start gap-4 pt-2\">\n              <span className=\"text-xs font-mono text-[#B0B0B0]\">Connect:</span>\n              <a\n                href=\"https://linkedin.com/in/amalshiyas\"\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"p-2 rounded-full hover:bg-white/[0.03] text-[#B0B0B0] hover:text-[#D32F2F] transition-all\"\n                title=\"LinkedIn Profile\"\n              >\n                <Linkedin size={18} />\n              </a>\n              <a\n                href=\"https://github.com/amalgotbusiness\"\n                target=\"_blank\"\n                rel=\"noreferrer\"\n                className=\"p-2 rounded-full hover:bg-white/[0.03] text-[#B0B0B0] hover:text-[#D32F2F] transition-all\"\n                title=\"GitHub Repositories\"\n              >\n                <Github size={18} />\n              </a>\n            </div>\n\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
